["صفية بنت عبد المطلب،",
"كانت في الحقيقة قريبة جدًا",
"من النبي ﷺ.",
"كانت قريبة منه في العمر.",
"في بعض الروايات،",
"أنها في نفس عمر",
"النبي محمد ﷺ.",
"وفي روايات أخرى،",
"أنها أكبر منه",
"بسنة واحدة فقط.",
"صفية رضي الله عنها،",
"لم تكن من",
"السابقين إلى الإسلام.",
"في الحقيقة،",
"أسلمت",
"بعد أخيها",
"{{gold}}حمزة{{/gold}} بن عبد المطلب.",
"فلما أسلم،",
"أسلمت هي أيضًا.",
"وهي {{gold}}أم{{/gold}}",
"الزبير رضي الله عنه،",
"والزبير أحد",
"العشرة المبشرين {{gold}}بالجنة.{{/gold}}",
"لكنها أيضًا",
"امرأة {{gold}}بارزة.{{/gold}}",
"ولها موقف شجاع جدًا",
"حدث أثناء",
"غزوة الخندق.",
"في غزوة الخندق،",
"كان المسلمون في الحقيقة",
"{{gold}}محاصرين{{/gold}} بالأعداء.",
"خارج المدينة،",
"قريش،",
"وداخل المدينة",
"من الخلف،",
"تجد",
"اليهود",
"الذين قرروا",
"نقض العهد",
"مع النبي محمد ﷺ",
"وقرروا",
"أن يكونوا ضده",
"في هذه الحرب.",
"وكان هناك {{gold}}حصن{{/gold}}",
"للنساء فقط.",
"وداخل هذا الحصن،",
"تجد النساء،",
"والأطفال، وكبار السن.",
"وحسان",
"بن ثابت رضي الله عنه.",
"حسان بن ثابت",
"هو شاعر",
"النبي محمد ﷺ.",
"فاقترب عدو",
"من الحصن،",
"وكأنه يظن",
"أن النساء فقط",
"في الداخل،",
"فأستطيع بسهولة أن آخذ",
"نساء المسلمين.",
"وبفعل ذلك،",
"يبدو وكأننا",
"أنهينا هذه الحرب.",
"فقرر",
"أن يدخل الحصن.",
"فصفية",
"بنت عبد المطلب،",
"في ذلك الوقت",
"كانت امرأة كبيرة في السن،",
"بالمناسبة.",
"فقالت",
"لحسان بن ثابت:",
"«اذهب وقاتل هذا الرجل.»",
"فقال: «لا، آسف.",
"أنا مجرد {{gold}}شاعر.{{/gold}}",
"لست جنديًا.",
"يمكنكِ أن تذهبي وحدكِ.»",
"فقررت السيدة صفية",
"أن تفعل ذلك",
"بنفسها.",
"حملت",
"نوعًا من {{gold}}العصا،{{/gold}}",
"وقررت",
"أن تضرب هذا الرجل.",
"وفعلت.",
"وليس هذا فقط،",
"بل قررت",
"أن تلقي هذا العدو",
"من الحصن.",
"فلما رأى الكفار",
"ذلك،",
"قالوا:",
"«يا إلهي،",
"بالتأكيد هناك",
"جنود كثيرون",
"داخل هذا الحصن،",
"فلن",
"نهاجمه أبدًا.»",
"{{gold}}فأنقذت{{/gold}} نساء",
"النبي محمد ﷺ.",
"{{gold}}أنقذت{{/gold}} نساء",
"المسلمين.",
"{{gold}}أنقذت{{/gold}} الجميع.",
"كانت امرأة شجاعة.",
"لم تكن جنديًا",
"ولا محاربة.",
"كانت مجرد امرأة",
"قررت أن تكون {{gold}}شجاعة{{/gold}}",
"في موقف ما.",
"ما أروعها!"]
